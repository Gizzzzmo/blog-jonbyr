<!DOCTYPE html>
<html lang="en">
<head>
    {% include 'head.jinja2' %}
    <link rel="stylesheet" href="/templates/technical-blog-feed.css">
</head>
<body>
    {% include "navbar.jinja2" %}

    <main class="main">
        <article class="article">
            <div class="article-content" id="feed-container">
                {% for article in config.articles %}
                {% if not article.meta.extra_config.hide_from_feed %}
                <div class="article-preview">
                    <a href="{{ article.path }}" class="preview-link"><h1 class="article-title">{{ article.meta.title or article.meta.id or "Untitled" }}</h1></a>
                    {% if article.meta.publish_date or article.meta.author %}
                    <div class="article-meta">
                        {% if article.meta.publish_date %}
                        <time datetime="{{ article.meta.publish_date }}">{{ article.meta.publish_date | format_date }}</time>
                        {% endif %}
                        {% if article.meta.author %}
                        <span class="author"> {{ article.meta.author }}</span>
                        {% endif %}
                    </div>
                    {% endif %}
                    {% if article.tags %}
                    <div class="article-tags">
                        {% for tag in article.tags %}
                        <a href="/tags.html#{{ tag }}" class="tag">{{ tag }}</a>
                        {% endfor %}
                    </div>
                    {% endif %}
                    <div class="preview-content">
                        {{ (article.preview or article.html) | safe }}
                        <a href="{{ article.path }}" class="preview-fade-link" aria-hidden="true"></a>
                    </div>
                </div>
                {% endif %}
                {% endfor %}
            </div>

            {% if config.pagination %}
            <nav class="pagination" aria-label="Feed pages">
                {% if config.pagination.prev_url %}
                <a href="{{ config.pagination.prev_url }}" rel="prev">&lt;</a>
                {% else %}
                <button disabled>&lt;</button>
                {% endif %}
                {% for p in config.pagination.pages %}
                    {% if p.current %}
                    <span class="page-current" aria-current="page">{{ p.num }}</span>
                    {% else %}
                    <a href="{{ p.url }}" class="page-num">{{ p.num }}</a>
                    {% endif %}
                {% endfor %}
                {% if config.pagination.next_url %}
                <a href="{{ config.pagination.next_url }}" rel="next">&gt;</a>
                {% else %}
                <button disabled>&gt;</button>
                {% endif %}
            </nav>
            {% endif %}
        </article>
    </main>

    {% include 'footer.jinja2' %}

    <script>
        {% include 'theme-script.jinja2' %}
    </script>
    {% if config.live_reload %}
    <script>
    // Local-dev auto-reload: polls the __version sentinel written by
    // `make local` and reloads when a rebuild completes. Only rendered
    // for local builds (gated by the live_reload define).
    (function () {
        var seen = null;
        setInterval(function () {
            fetch('/__version?x=' + Date.now()).then(function (r) {
                if (!r.ok) return null;
                return r.text();
            }).then(function (v) {
                if (v === null) return;
                if (seen === null) { seen = v; return; }
                if (v !== seen) location.reload();
            }).catch(function () {});
        }, 750);
    })();
    </script>
    {% endif %}
</body>
</html>
