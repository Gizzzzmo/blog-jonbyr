<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ config.title or config.id or 'Untitled' }}</title>
    <link rel="stylesheet" href="/templates/technical-blog.css">
    <link rel="stylesheet" href="/templates/technical-blog-feed.css">
    <link rel="stylesheet" href="/themes/{{ config.default_theme or config.theme or 'dracula' }}.css" id="theme-stylesheet">
    {% if config.content_assets %}
    <style>
        @font-face {
            font-family: 'Fira Code';
            src: url('{{ config.content_assets.fira_code }}') format('truetype');
            font-weight: normal;
            font-style: normal;
        }
        @font-face {
            font-family: 'Saira';
            src: url('{{ config.content_assets.saira }}') format('truetype');
            font-weight: 100 900;
            font-style: normal;
        }
    </style>
    {% endif %}
</head>
<body>
    <nav class="nav">
        <div class="nav-container">
            <div class="nav-left">
                <a href="/" class="nav-logo">{{ config.site_name or 'My Blog' }}</a>
            </div>
            {% if config.themes and config.themes|length > 1 %}
            <div class="theme-selector" id="theme-selector">
                <select id="theme-select" aria-label="Select theme">
                    {% for theme in config.themes %}
                    <option value="{{ theme }}" {% if theme == (config.default_theme or config.theme or 'dracula') %}selected{% endif %}>
                        {{ theme }}
                    </option>
                    {% endfor %}
                </select>
            </div>
            {% endif %}
            <div class="nav-git">
                <span class="nav-git-icon" aria-hidden="true">
                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 256 256"><path d="M251.172 116.594L139.4 4.828c-6.433-6.437-16.873-6.437-23.314 0l-23.21 23.21 29.443 29.443c6.842-2.312 14.688-.761 20.142 4.693 5.48 5.489 7.02 13.402 4.652 20.266l28.375 28.376c6.865-2.365 14.786-.835 20.269 4.657 7.663 7.66 7.663 20.075 0 27.74-7.665 7.666-20.08 7.666-27.749 0-5.764-5.77-7.188-14.235-4.27-21.336l-26.462-26.462-.003 69.637a19.82 19.82 0 0 1 5.188 3.71c7.663 7.66 7.663 20.076 0 27.747-7.665 7.662-20.086 7.662-27.74 0-7.663-7.671-7.663-20.086 0-27.746a19.654 19.654 0 0 1 6.421-4.281V94.196a19.378 19.378 0 0 1-6.421-4.281c-5.806-5.798-7.202-14.317-4.227-21.446L81.47 39.442l-76.64 76.635c-6.44 6.443-6.44 16.884 0 23.322l111.774 111.768c6.435 6.438 16.873 6.438 23.316 0l111.251-111.249c6.438-6.44 6.438-16.887 0-23.324" fill="#000000"/></svg>
                </span>
                <a href="{{ config.source_latest_url }}">latest</a>
                {% if config.version_history %}
                {% set current_version = config.version_history[-1] %}
                <a href="{{ config.source_version_url }}/{{ current_version.commit }}" title="{{ current_version.commit }}">{{ current_version.commit[:8] }}</a>
                {% endif %}
            </div>
        </div>
    </nav>

    <main class="main">
        <article class="article">
            <div class="article-content" id="feed-container">
                {% for article in config.articles %}
                <div class="article-preview">
                    <a href="{{ article.path }}" class="preview-link"><h1 class="article-title">{{ article.meta.title or article.meta.id or "Untitled" }}</h1></a>
                    {% if article.meta.publish_date or article.meta.author %}
                    <div class="article-meta">
                        {% if article.meta.publish_date %}
                        <time datetime="{{ article.meta.publish_date }}">{{ article.meta.publish_date | format_date }}</time>
                        {% endif %}
                        {% if article.meta.author %}
                        <span class="author"> {{ article.meta.author }}</span>
                        {% endif %}
                    </div>
                    {% endif %}
                    {% if article.tags %}
                    <div class="article-tags">
                        {% for tag in article.tags %}
                        <a href="/tags.html#{{ tag }}" class="tag">{{ tag }}</a>
                        {% endfor %}
                    </div>
                    {% endif %}
                    <div class="preview-content">
                        {{ (article.preview or article.html) | safe }}
                        <a href="{{ article.path }}" class="preview-fade-link" aria-hidden="true"></a>
                    </div>
                </div>
                {% endfor %}
            </div>

            {% if config.pagination %}
            <nav class="pagination" aria-label="Feed pages">
                {% if config.pagination.prev_url %}
                <a href="{{ config.pagination.prev_url }}" rel="prev">&lt;</a>
                {% else %}
                <button disabled>&lt;</button>
                {% endif %}
                {% for p in config.pagination.pages %}
                    {% if p.current %}
                    <span class="page-current" aria-current="page">{{ p.num }}</span>
                    {% else %}
                    <a href="{{ p.url }}" class="page-num">{{ p.num }}</a>
                    {% endif %}
                {% endfor %}
                {% if config.pagination.next_url %}
                <a href="{{ config.pagination.next_url }}" rel="next">&gt;</a>
                {% else %}
                <button disabled>&gt;</button>
                {% endif %}
            </nav>
            {% endif %}
        </article>
    </main>

    <footer class="footer">
        <div class="footer-container">
            <p>&copy; 2025 {{ config.site_name or 'My Blog' }}. All rights reserved.</p>
        </div>
    </footer>

    <script>
        {% if config.themes and config.themes|length > 1 %}
        (function() {
            const themeSelect = document.getElementById('theme-select');
            const themeSelector = document.getElementById('theme-selector');
            const themeStylesheet = document.getElementById('theme-stylesheet');
            const THEME_STORAGE_KEY = 'selected-theme';
            const DEFAULT_THEME = '{{ config.default_theme or config.theme or "dracula" }}';

            function loadSavedTheme() {
                const savedTheme = localStorage.getItem(THEME_STORAGE_KEY);
                if (savedTheme && themeSelect) {
                    const option = Array.from(themeSelect.options).find(opt => opt.value === savedTheme);
                    if (option) {
                        themeSelect.value = savedTheme;
                        applyTheme(savedTheme);
                    }
                } else {
                    applyTheme(DEFAULT_THEME);
                }
            }

            function applyTheme(themeName) {
                if (themeStylesheet) {
                    themeStylesheet.href = `/themes/${themeName}.css`;
                }
            }

            if (themeSelect) {
                themeSelect.addEventListener('change', function() {
                    const selectedTheme = this.value;
                    applyTheme(selectedTheme);
                    localStorage.setItem(THEME_STORAGE_KEY, selectedTheme);
                });
            }

            document.addEventListener('keydown', function(e) {
                if (e.ctrlKey && e.shiftKey && e.key === 'T') {
                    e.preventDefault();
                    if (themeSelector) {
                        themeSelector.classList.toggle('visible');
                    }
                }
            });

            const navLogo = document.querySelector('.nav-logo');
            let longPressTimer = null;
            let touchStartTime = 0;
            const LONG_PRESS_DURATION = 500;

            if (navLogo) {
                navLogo.addEventListener('touchstart', function(e) {
                    touchStartTime = Date.now();
                    longPressTimer = setTimeout(function() {
                        if (themeSelector) {
                            themeSelector.classList.toggle('visible');
                            navigator.vibrate && navigator.vibrate(50);
                        }
                    }, LONG_PRESS_DURATION);
                });

                navLogo.addEventListener('touchend', function(e) {
                    const touchDuration = Date.now() - touchStartTime;
                    if (longPressTimer) {
                        clearTimeout(longPressTimer);
                    }
                    if (touchDuration < LONG_PRESS_DURATION) {
                        window.location.href = navLogo.href;
                    } else {
                        e.preventDefault();
                    }
                });

                navLogo.addEventListener('touchmove', function(e) {
                    if (longPressTimer) {
                        clearTimeout(longPressTimer);
                        longPressTimer = null;
                    }
                });

                navLogo.addEventListener('touchcancel', function(e) {
                    if (longPressTimer) {
                        clearTimeout(longPressTimer);
                        longPressTimer = null;
                    }
                });
            }

            loadSavedTheme();
        })();
        {% endif %}
    </script>
    {% if config.live_reload %}
    <script>
    // Local-dev auto-reload: polls the __version sentinel written by
    // `make local` and reloads when a rebuild completes. Only rendered
    // for local builds (gated by the live_reload define).
    (function () {
        var seen = null;
        setInterval(function () {
            fetch('/__version?x=' + Date.now()).then(function (r) {
                if (!r.ok) return null;
                return r.text();
            }).then(function (v) {
                if (v === null) return;
                if (seen === null) { seen = v; return; }
                if (v !== seen) location.reload();
            }).catch(function () {});
        }, 750);
    })();
    </script>
    {% endif %}
</body>
</html>
