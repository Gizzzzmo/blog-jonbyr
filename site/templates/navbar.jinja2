<nav class="nav">
    <div class="nav-container">
        <div class="nav-left">
            {% if show_sidebar_toggle|default(false) and config.extra_config.sidebar and config.articles and config.articles|length > 0 %}
            <button class="sidebar-toggle" id="sidebar-toggle" aria-label="Toggle sidebar">☰</button>
            {% endif %}
            <div class="nav-brand">
            <a href="/" class="nav-logo">{{ config.site_name or 'My Blog' }}</a>
            {# Archive marker: hidden until archive-script reveals it on
            versioned hosts. data-commit is this build's source commit;
            data-commit-url serves the newest built commit for comparison. #}
            <span class="archive-wrap" hidden data-commit="{{ config.commit or '' }}" data-canonical-root="{{ config.site_url or '' }}" data-commit-url="{% if config.site_url and config.commit_file %}{{ config.site_url.rstrip('/') }}/{{ config.commit_file }}{% endif %}">
            <span class="archive-tag" tabindex="0">archive</span>
            <div class="archive-panel"><p>This is an older version (<code class="archive-this">…</code>) of this site.</p><p>Browse the latest version at <a class="archive-root" href="{{ config.site_url or '/' }}">…</a> (<code class="archive-latest">…</code>).<span class="archive-note" hidden> Could not verify the newest version.</span></p></div>
            </span>
            </div>
            <div class="nav-pages">
                <span class="nav-chip"><a href="/tags.html">tags</a></span>
                <span class="nav-chip"><a href="/about.html">about</a></span>
            </div>
            <div class="nav-toggle-col">
                <span class="nav-chip"><button class="theme-toggle" id="theme-toggle" aria-label="Toggle light/dark theme" title="Toggle light/dark theme">
                    <span id="theme-toggle-label">dark</span>
                </button></span>
                {# Second chip row: canonical RSS feed. Absolute URL, so
                versioned hosts still reach the newest feed. The filename
                mirrors the rss: output in .config.yaml (rename one, rename
                the other). A plain link: useful without scripts, hence
                exempt from JS-gating. #}
                {% if config.site_url %}
                <span class="nav-chip"><a class="feed-link" href="{{ config.site_url.rstrip('/') }}/feed.xml" title="Latest RSS feed">rss</a></span>
                {% endif %}
            </div>
        </div>
        {# extra_config.themes is the canonical source; top-level config.themes
        is a fallback for contexts that hoist it. The light/dark toggle is
        always rendered (production behavior); the full selector is an
        additional, hidden possibility in local-test builds (all_themes). #}
        {% set theme_list = (config.extra_config.themes if config.extra_config else none) or config.themes %}
        {% set default_theme = (config.extra_config.default_theme if config.extra_config else none) or config.default_theme or config.theme or 'dracula' %}
        {% if config.all_themes and theme_list and theme_list|length > 1 %}
        <div class="theme-selector" id="theme-selector">
            <select id="theme-select" aria-label="Select theme">
                {% for theme in theme_list %}
                <option value="{{ theme }}" {% if theme == default_theme %}selected{% endif %}>
                    {{ theme }}
                </option>
                {% endfor %}
            </select>
        </div>
        {% endif %}
        <div class="nav-git">
            <div class="nav-git-links">
                {% if config.version_history %}
                {% set current_version = config.version_history[-1] %}
                <a href="{{ config.source_version_url }}/{{ current_version.commit }}" title="{{ current_version.commit }}">{{ current_version.commit[:8] }}</a>
                {% endif %}
                <a href="{{ config.source_latest_url }}">latest</a>
            </div>
            <span class="nav-git-icon" aria-hidden="true">
                <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 256 256"><path d="M251.172 116.594L139.4 4.828c-6.433-6.437-16.873-6.437-23.314 0l-23.21 23.21 29.443 29.443c6.842-2.312 14.688-.761 20.142 4.693 5.48 5.489 7.02 13.402 4.652 20.266l28.375 28.376c6.865-2.365 14.786-.835 20.269 4.657 7.663 7.66 7.663 20.075 0 27.74-7.665 7.666-20.08 7.666-27.749 0-5.764-5.77-7.188-14.235-4.27-21.336l-26.462-26.462-.003 69.637a19.82 19.82 0 0 1 5.188 3.71c7.663 7.66 7.663 20.076 0 27.747-7.665 7.662-20.086 7.662-27.74 0-7.663-7.671-7.663-20.086 0-27.746a19.654 19.654 0 0 1 6.421-4.281V94.196a19.378 19.378 0 0 1-6.421-4.281c-5.806-5.798-7.202-14.317-4.227-21.446L81.47 39.442l-76.64 76.635c-6.44 6.443-6.44 16.884 0 23.322l111.774 111.768c6.435 6.438 16.873 6.438 23.316 0l111.251-111.249c6.438-6.44 6.438-16.887 0-23.324" fill="#000000"/></svg>
            </span>
        </div>
    </div>
</nav>
