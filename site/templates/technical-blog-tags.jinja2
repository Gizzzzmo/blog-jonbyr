<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Tags - {{ config.site_name or 'My Blog' }}</title>
    <link rel="stylesheet" href="/templates/technical-blog.css">
    <link rel="stylesheet" href="/templates/technical-blog-tags.css">
    <link rel="stylesheet" href="/themes/{{ config.default_theme or config.theme or 'dracula' }}.css" id="theme-stylesheet">
    {% if config.content_assets %}
    <style>
        @font-face {
            font-family: 'Fira Code';
            src: url('{{ config.content_assets.fira_code }}') format('truetype');
            font-weight: normal;
            font-style: normal;
        }
        @font-face {
            font-family: 'Saira';
            src: url('{{ config.content_assets.saira }}') format('truetype');
            font-weight: 100 900;
            font-style: normal;
        }
    </style>
    {% endif %}
</head>
<body>
    <nav class="nav">
        <div class="nav-container">
            <div class="nav-left">
                <a href="/" class="nav-logo">{{ config.site_name or 'My Blog' }}</a>
            </div>
            {% if config.themes and config.themes|length > 1 %}
            <div class="theme-selector" id="theme-selector">
                <select id="theme-select" aria-label="Select theme">
                    {% for theme in config.themes %}
                    <option value="{{ theme }}" {% if theme == (config.default_theme or config.theme or 'dracula') %}selected{% endif %}>
                        {{ theme }}
                    </option>
                    {% endfor %}
                </select>
            </div>
            {% endif %}
            <details class="nav-git">
                <summary aria-label="Source repository">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"></path></svg>
                </summary>
                <div class="nav-git-menu">
                    <a href="{{ config.source_latest_url }}">latest</a>
                    {% if config.version_history %}
                    {% set current_version = config.version_history[-1] %}
                    <a href="{{ config.source_version_url }}/{{ current_version.commit }}" title="{{ current_version.commit }}">{{ current_version.commit[:8] }}</a>
                    {% endif %}
                </div>
            </details>
        </div>
    </nav>

    <main class="main">
        <article class="article">
            <header class="article-header">
                <h1 class="article-title" id="article-title">Tags</h1>
            </header>
            <div class="article-content tags-index">
                {% if config.tag_sections %}
                {% for section in config.tag_sections %}
                <section class="tag-section" id="{{ section.name }}">
                    <h3 class="tag-heading"><a href="#{{ section.name }}" class="anchor">#</a>{{ section.name }}</h2>
                    <div class="tag-articles">
                        {% for article in section.articles %}
                        <div class="tag-article-row">
                            <a href="{{ article.url }}">{{ article.title }}</a>
                            {% if article.publish_date %}
                            <time datetime="{{ article.publish_date }}">{{ article.publish_date | format_date }}</time>
                            {% endif %}
                        </div>
                        {% endfor %}
                    </div>
                </section>
                {% endfor %}
                {% else %}
                {{ content | safe }}
                {% endif %}
            </div>
        </article>
    </main>

    <footer class="footer">
        <div class="footer-container">
            <p>&copy; 2025 {{ config.site_name or 'My Blog' }}. All rights reserved.</p>
        </div>
    </footer>

    <script>
        {% if config.themes and config.themes|length > 1 %}
        (function() {
            const themeSelect = document.getElementById('theme-select');
            const themeSelector = document.getElementById('theme-selector');
            const themeStylesheet = document.getElementById('theme-stylesheet');
            const THEME_STORAGE_KEY = 'selected-theme';
            const DEFAULT_THEME = '{{ config.default_theme or config.theme or "dracula" }}';

            function loadSavedTheme() {
                const savedTheme = localStorage.getItem(THEME_STORAGE_KEY);
                if (savedTheme && themeSelect) {
                    const option = Array.from(themeSelect.options).find(opt => opt.value === savedTheme);
                    if (option) {
                        themeSelect.value = savedTheme;
                        applyTheme(savedTheme);
                    }
                } else {
                    applyTheme(DEFAULT_THEME);
                }
            }

            function applyTheme(themeName) {
                if (themeStylesheet) {
                    themeStylesheet.href = `/themes/${themeName}.css`;
                }
            }

            if (themeSelect) {
                themeSelect.addEventListener('change', function() {
                    const selectedTheme = this.value;
                    applyTheme(selectedTheme);
                    localStorage.setItem(THEME_STORAGE_KEY, selectedTheme);
                });
            }

            loadSavedTheme();
        })();
        {% endif %}
    </script>
    {% if config.live_reload %}
    <script>
    // Local-dev auto-reload: polls the __version sentinel written by
    // `make local` and reloads when a rebuild completes. Only rendered
    // for local builds (gated by the live_reload define).
    (function () {
        var seen = null;
        setInterval(function () {
            fetch('/__version?x=' + Date.now()).then(function (r) {
                if (!r.ok) return null;
                return r.text();
            }).then(function (v) {
                if (v === null) return;
                if (seen === null) { seen = v; return; }
                if (v !== seen) location.reload();
            }).catch(function () {});
        }, 750);
    })();
    </script>
    {% endif %}
</body>
</html>
