<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ config.title or config.id or 'Untitled' }}</title>
    <link rel="stylesheet" href="/templates/technical-blog.css">
    <link rel="stylesheet" href="/themes/{{ config.extra_config.default_theme or config.theme or 'dracula' }}.css" id="theme-stylesheet">
    {% if config.content_assets %}
    <style>
        @font-face {
            font-family: 'Fira Code';
            src: url('{{ config.content_assets.fira_code }}') format('truetype');
            font-weight: normal;
            font-style: normal;
        }
        @font-face {
            font-family: 'Saira';
            src: url('{{ config.content_assets.saira }}') format('truetype');
            font-weight: 100 900;
            font-style: normal;
        }
    </style>
    {% endif %}
    <style>
        .theme-selector { display: none; }
        .theme-selector.visible { display: block; }
        {% if config.extra_config.sidebar and config.articles and config.articles|length > 0 %}
        @media (max-width: 1280px) and (min-width: 1080px) {
            .article {
                transform: translateX(14vw);
            }

            .nav-container div {
                transform: translateX(8vw);
            }

            .articles-sidebar {
                width: calc((100vw - max(900px, 60vw)) * 0.9);
            }
        }
        {% endif %}
    </style>
</head>
<body>
    <nav class="nav">
        <div class="nav-container">
            <div class="nav-left">
                {% if config.extra_config.sidebar and config.articles and config.articles|length > 0 %}
                <button class="sidebar-toggle" id="sidebar-toggle" aria-label="Toggle sidebar">☰</button>
                {% endif %}
                <a href="/" class="nav-logo">{{ config.site_name or 'My Blog' }}</a>
            </div>
            {% if config.extra_config.themes and config.extra_config.themes|length > 1 %}
            <div class="theme-selector" id="theme-selector">
                <select id="theme-select" aria-label="Select theme">
                    {% for theme in config.extra_config.themes %}
                    <option value="{{ theme }}" {% if theme == (config.extra_config.default_theme or config.theme or 'dracula') %}selected{% endif %}>
                        {{ theme }}
                    </option>
                    {% endfor %}
                </select>
            </div>
            {% endif %}
        </div>
    </nav>

    {% macro render_toc_section(section) %}
    <li>
        <a href="#{{ section.id }}" data-section-id="{{ section.id }}">{% if section.number %}<span class="header-section-number">{{ section.number }}</span> {% endif %}{{ section.text }}</a>
        {% if section.children %}
        <ul class="toc-subsections">
            {% for child in section.children %}
            {{ render_toc_section(child) }}
            {% endfor %}
        </ul>
        {% endif %}
    </li>
    {% endmacro %}

    <main class="main">
        {% if config.extra_config.sidebar and config.articles and config.articles|length > 0 %}
        <aside class="articles-sidebar">
            <div class="articles-sidebar-panel">
            <div class="articles-sidebar-header">
                {% if config.sidebar_title %}
                <h3 class="articles-sidebar-title"> {{ config.sidebar_title }} </h3>
                {% endif %}
                <button class="sidebar-close" id="sidebar-close" aria-label="Close sidebar">×</button>
            </div>
            <nav class="articles-nav">
                <ul class="articles-list {% if config.sidebar_numbered %}numbered{% endif %}">
                    {% for article in config.articles %}
                    <li>
                        <a href="{{ article.path }}" class="article-link">
                            {% if config.sidebar_numbered %}<span class="article-number">{{ loop.index }}.</span> {% endif %}<span class="article-title-small">{{ article.meta.title or article.meta.id or 'Untitled' }}</span>
                        </a>
                    </li>
                    {% endfor %}
                </ul>
            </nav>
            </div>
        </aside>
        <div class="sidebar-backdrop"></div>
        {% endif %}

        {% set toc_option = config.toc_display|default('auto') %}
        {# Normalize boolean values to strings (YAML converts on/off to true/false) #}
        {% if toc_option is sameas true %}
            {% set toc_option = 'on' %}
        {% elif toc_option is sameas false %}
            {% set toc_option = 'off' %}
        {% endif %}
        {% set should_show_toc = (toc_option == 'on') or (toc_option == 'auto' and config.toc and config.toc|length >= 5) or (toc_option != 'off' and toc_option != 'on' and toc_option != 'auto' and config.toc and config.toc|length >= 5) %}
        {% if should_show_toc and config.toc and config.toc|length > 0 %}
        <button class="toc-toggle" aria-label="Toggle table of contents">#</button>
        <div class="toc-backdrop"></div>
        <aside class="toc">
            <div class="toc-handle-container"><div class="toc-handle"></div></div>
            <nav class="toc-nav">
                <ul class="toc-list">
                    {% for section in config.toc %}
                    {{ render_toc_section(section) }}
                    {% endfor %}
                    {% if config.bibliography_html %}
                    <li>
                        <a href="#references" data-section-id="references">References</a>
                    </li>
                    {% endif %}
                </ul>
            </nav>
        </aside>
        {% endif %}

        <article class="article">
            <header class="article-header">
                <h1 class="article-title" id="article-title">{{ config.title or config.id or 'Untitled' }}</h1>
                <div class="article-meta">
                    {% if config.publish_date %}
                    <time datetime="{{ config.publish_date }}">{{ config.publish_date | format_date }}</time>
                    {% endif %}
                    {% if config.author %}
                    <span class="author"> {{ config.author }}</span>
                    {% endif %}
                    {% if config.export_markdown and config.exported_markdown_url %}
                    <a class="md-source" href="{{ config.exported_markdown_url }}">&lt;md/&gt;</a>
                    {% endif %}
                </div>
                {% if config.tags %}
                <div class="article-tags">
                    {% for tag in config.tags %}
                    <a href="/tags.html#{{ tag }}" class="tag">{{ tag }}</a>
                    {% endfor %}
                </div>
                {% endif %}
            </header>
            
            <div class="article-content">
                {{ content }}
                {% if config.bibliography_html %}
                <h2 id="references"> 
                    {% if config.anchor_links == 'left' %} 
                    <a href="#references" class="anchor">#</a> 
                    {% endif %}

                    {% if config.anchor_links == 'self' %} 
                    <a href="#references" class="anchor">
                    {% endif %}
                    References 
                    {% if config.anchor_links =='self' %} 
                    </a>
                    {% endif %}
                    {% if config.anchor_links == 'right' %}
                    <a href="#references" class="anchor">#</a> 
                    {% endif %}
                </h2>
                {{ config.bibliography_html }}
                {% endif %}
            </div>
        </article>
    </main>

    {% if config.site_name %}
    <footer class="footer">
        <div class="footer-container">
            <p>&copy; 2025 {{ config.site_name }}</p>
        </div>
    </footer>
    {% endif %}

    <script>
        {% if config.extra_config.sidebar and config.articles and config.articles|length > 0 %}
        (function() {
            const sidebarToggle = document.getElementById('sidebar-toggle');
            const sidebarClose = document.getElementById('sidebar-close');
            const sidebar = document.querySelector('.articles-sidebar');
            const sidebarBackdrop = document.querySelector('.sidebar-backdrop');
            const SIDEBAR_STORAGE_KEY = 'sidebar-visible';

            function setSidebarOpen(open) {
                sidebar.classList.toggle('visible', open);
                if (sidebarBackdrop) {
                    sidebarBackdrop.classList.toggle('active', open);
                }
                localStorage.setItem(SIDEBAR_STORAGE_KEY, open);
            }

            function toggleSidebar() {
                setSidebarOpen(!sidebar.classList.contains('visible'));
            }

            function closeSidebar() {
                setSidebarOpen(false);
            }

            function loadSidebarState() {
                const isLargeScreen = window.matchMedia('(min-width: 1080px)').matches;
                const savedState = localStorage.getItem(SIDEBAR_STORAGE_KEY);
                
                if (savedState !== null) {
                    const isVisible = savedState === 'true';
                    if (isVisible) {
                        setSidebarOpen(true);
                    }
                } else if (isLargeScreen) {
                    setSidebarOpen(true);
                }
            }

            if (sidebarToggle) {
                sidebarToggle.addEventListener('click', toggleSidebar);
            }

            if (sidebarClose) {
                sidebarClose.addEventListener('click', closeSidebar);
            }

            if (sidebarBackdrop) {
                sidebarBackdrop.addEventListener('click', closeSidebar);
            }

            window.addEventListener('close-sidebar', closeSidebar);

            loadSidebarState();
        })();
        {% endif %}

        function compiler_explorer(code_block, lang, config = {}) {
            var code = code_block.getAttribute('data-code');

            // https://godbolt.org/api/compilers
            id = config.compiler || "clang_trunk";
            options = config.options || "";
            libs = config.libs || [];
            showAsm = "showAsm" in config ? config.asm : true;
            run = "run" in config ? config.run : false;
            

            language_mapping = {
                "cpp": "c++",
            }

            if (lang in language_mapping) {
                lang = language_mapping[lang];
            }

            var request_body = {
                sessions: [
                    {
                        id: 1,
                        language: lang,
                        source: code,
                    }
                ]
            }
            if (showAsm) {
                request_body.sessions[0].compilers = [
                    {
                        id: id,
                        libs: libs,
                        options: options
                    } 
                ]
            }
            if (run) {
                request_body.sessions[0].executors = [
                    {
                        compiler: {
                            id: id,
                            libs: libs,
                            options: options
                        }
                    }
                ]
            }
            // base64 encode the code
            var url = "https://godbolt.org/clientstate/" + btoa(JSON.stringify(request_body));
            // open in new tab
            window.open(url, '_blank');
        }
        {% if config.extra_config.themes and config.extra_config.themes|length > 1 %}
        (function() {
            const themeSelect = document.getElementById('theme-select');
            const themeSelector = document.getElementById('theme-selector');
            const themeStylesheet = document.getElementById('theme-stylesheet');
            const THEME_STORAGE_KEY = 'selected-theme';
            const DEFAULT_THEME = '{{ config.extra_config.default_theme or config.theme or "dracula" }}';

            function loadSavedTheme() {
                const savedTheme = localStorage.getItem(THEME_STORAGE_KEY);
                if (savedTheme && themeSelect) {
                    const option = Array.from(themeSelect.options).find(opt => opt.value === savedTheme);
                    if (option) {
                        themeSelect.value = savedTheme;
                        applyTheme(savedTheme);
                    }
                } else {
                    applyTheme(DEFAULT_THEME);
                }
            }

            function applyTheme(themeName) {
                if (themeStylesheet) {
                    themeStylesheet.href = `/themes/${themeName}.css`;
                }
            }

            if (themeSelect) {
                themeSelect.addEventListener('change', function() {
                    const selectedTheme = this.value;
                    applyTheme(selectedTheme);
                    localStorage.setItem(THEME_STORAGE_KEY, selectedTheme);
                });
            }

            document.addEventListener('keydown', function(e) {
                if (e.ctrlKey && e.shiftKey && e.key === 'T') {
                    e.preventDefault();
                    if (themeSelector) {
                        themeSelector.classList.toggle('visible');
                    }
                }
            });

            const navLogo = document.querySelector('.nav-logo');
            let longPressTimer = null;
            let touchStartTime = 0;
            const LONG_PRESS_DURATION = 500;

            if (navLogo) {
                navLogo.addEventListener('touchstart', function(e) {
                    touchStartTime = Date.now();
                    longPressTimer = setTimeout(function() {
                        if (themeSelector) {
                            themeSelector.classList.toggle('visible');
                            navigator.vibrate && navigator.vibrate(50);
                        }
                    }, LONG_PRESS_DURATION);
                });

                navLogo.addEventListener('touchend', function(e) {
                    const touchDuration = Date.now() - touchStartTime;
                    if (longPressTimer) {
                        clearTimeout(longPressTimer);
                    }
                    if (touchDuration < LONG_PRESS_DURATION) {
                        window.location.href = navLogo.href;
                    } else {
                        e.preventDefault();
                    }
                });

                navLogo.addEventListener('touchmove', function(e) {
                    if (longPressTimer) {
                        clearTimeout(longPressTimer);
                        longPressTimer = null;
                    }
                });

                navLogo.addEventListener('touchcancel', function(e) {
                    if (longPressTimer) {
                        clearTimeout(longPressTimer);
                        longPressTimer = null;
                    }
                });
            }

            loadSavedTheme();
        })();
        {% endif %}

        {% if config.enable_source_map %}
        document.addEventListener('dblclick', function(e) {
            console.log("Double click detected", e);
            let target = e.target;
            
            while (target && target !== document.body) {
                const sourceFile = target.getAttribute('data-source-file');
                const sourceLine = target.getAttribute('data-source-line');

                console.log("Checking element:", target, "Source file:", sourceFile, "Source line:", sourceLine);
                
                if (sourceFile && sourceLine) {
                    console.log("Opening in editor:", sourceFile, sourceLine);
                    fetch(`http://localhost:8765/open?file=${encodeURIComponent(sourceFile)}&line=${sourceLine}`)
                        .catch(err => console.error('Failed to open in editor:', err));
                    e.preventDefault();
                    break;
                }
                
                target = target.parentElement;
            }
        });
        {% endif %}

        {% set toc_option = config.toc_display|default('auto') %}
        {% set should_show_toc = (toc_option == 'on') or (toc_option == 'auto' and config.toc and config.toc|length >= 5) or (toc_option != 'off' and toc_option != 'on' and toc_option != 'auto' and config.toc and config.toc|length >= 5) %}
        function legacyCopyToClipboard(text) {
            try {
                var textarea = document.createElement('textarea');
                textarea.value = text;
                textarea.setAttribute('readonly', '');
                textarea.style.position = 'fixed';
                textarea.style.top = '0';
                textarea.style.left = '0';
                textarea.style.opacity = '0';
                document.body.appendChild(textarea);
                textarea.select();
                textarea.setSelectionRange(0, textarea.value.length);
                var ok = document.execCommand('copy');
                document.body.removeChild(textarea);
                return !!ok;
            } catch (err) {
                return false;
            }
        }

        function copyCodeToClipboard(text) {
            if (navigator.clipboard && navigator.clipboard.writeText) {
                return navigator.clipboard.writeText(text).catch(function(err) {
                    if (legacyCopyToClipboard(text)) {
                        return Promise.resolve();
                    }
                    return Promise.reject(err);
                });
            }
            if (legacyCopyToClipboard(text)) {
                return Promise.resolve();
            }
            return Promise.reject(new Error('copy unavailable'));
        }

        document.addEventListener('DOMContentLoaded', function() {
            const copyButtons = document.querySelectorAll('.code-block-copy');
            copyButtons.forEach(button => {
                button.addEventListener('click', function(e) {
                    e.preventDefault();
                    const wrapper = this.closest('.code-block-wrapper');
                    const code = wrapper.getAttribute('data-code');
                    
                    if (code) {
                        copyCodeToClipboard(code).then(() => {
                            this.textContent = 'Copied!';
                            setTimeout(() => {
                                this.textContent = 'Copy';
                            }, 2000);
                        }).catch(err => {
                            console.error('Failed to copy:', err);
                            this.textContent = 'Failed';
                            setTimeout(() => {
                                this.textContent = 'Copy';
                            }, 2000);
                        });
                    }
                });
            });

            const spoilers = document.querySelectorAll('.spoiler');
            spoilers.forEach(spoiler => {
                spoiler.addEventListener('click', function(e) {
                    if (!this.classList.contains('revealed')) {
                        // When blurred, click anywhere to reveal
                        this.classList.add('revealed');
                    } else {
                        // When revealed, only clicking the button (::before) should hide
                        const rect = this.getBoundingClientRect();
                        const buttonArea = {
                            top: rect.top + 8,
                            right: rect.right - 8,
                            bottom: rect.top + 30,
                            left: rect.right - 60
                        };
                        
                        const isButtonClick = (
                            e.clientX >= buttonArea.left &&
                            e.clientX <= buttonArea.right &&
                            e.clientY >= buttonArea.top &&
                            e.clientY <= buttonArea.bottom
                        );
                        
                        if (isButtonClick) {
                            this.classList.remove('revealed');
                        }
                    }
                });
            });

        });

        {% if should_show_toc and config.toc and config.toc|length > 0 %}
        document.addEventListener('DOMContentLoaded', function() {
            const toc = document.querySelector('.toc');
            if (!toc) return;

            const tocToggle = document.querySelector('.toc-toggle');
            const tocHandle = document.querySelector('.toc-handle');
            const tocClose = document.querySelector('.toc-close');
            const tocNav = document.querySelector('.toc-nav');
            const tocLinks = document.querySelectorAll('.toc-list a');
            const sections = Array.from(tocLinks).map(link => {
                const id = link.getAttribute('href').substring(1);
                return document.getElementById(id);
            }).filter(el => el !== null);

            const nav = document.querySelector('.nav');
            let navBottom = 0;
            
            function updateNavPosition() {
                const navRect = nav.getBoundingClientRect();
                navBottom = nav.offsetTop + nav.offsetHeight;
            }
            
            updateNavPosition();

            const tocBackdrop = document.querySelector('.toc-backdrop');

            let bodyScrollLocked = false;
            let tocHoverLocked = false;

            function closeToc() {
                toc.classList.remove('mobile-open');
                // The drawer is gone, so any hover state is stale by
                // definition (a tap can synthesize mouseenter with no
                // matching mouseleave on touch devices).
                tocHoverLocked = false;
                updateBodyScrollLock();
                if (tocBackdrop) {
                    tocBackdrop.classList.remove('active');
                }
                if (tocToggle) {
                    tocToggle.checked = false;
                    tocToggle.classList.remove('hidden');
                }
            }

            function openToc() {
                toc.classList.add('mobile-open');
                window.dispatchEvent(new CustomEvent('close-sidebar'));
                if (tocBackdrop) {
                    tocBackdrop.classList.add('active');
                }
                if (tocToggle) {
                    tocToggle.classList.add('hidden');
                }
            }

            function isEditableTarget(target) {
                if (!target || !target.closest) return false;
                return Boolean(target.closest('input, textarea, select, [contenteditable="true"]'));
            }

            function blockBodyWheel(e) {
                if (toc.contains(e.target)) return;
                e.preventDefault();
            }

            const BODY_SCROLL_KEYS = [' ', 'Spacebar', 'ArrowUp', 'ArrowDown', 'ArrowLeft', 'ArrowRight', 'Home', 'End', 'PageUp', 'PageDown'];

            function blockBodyKeys(e) {
                if (!BODY_SCROLL_KEYS.includes(e.key)) return;
                if (isEditableTarget(e.target)) return;
                if (toc.contains(e.target)) return;
                e.preventDefault();
            }

            // Freezes body scrolling for wheel/keyboard input while the mouse
            // hovers the TOC (floating panel or open drawer alike) without
            // touching `overflow`, so the viewport scrollbar stays rendered
            // exactly where it is. Touch input needs no JS blocking: the
            // backdrop is a pure tap-to-close layer, and drags starting in
            // the TOC are contained by its `overscroll-behavior: contain`.
            function updateBodyScrollLock() {
                const wantLock = tocHoverLocked;
                if (wantLock === bodyScrollLocked) return;
                bodyScrollLocked = wantLock;
                if (wantLock) {
                    document.addEventListener('wheel', blockBodyWheel, { passive: false });
                    document.addEventListener('keydown', blockBodyKeys);
                } else {
                    document.removeEventListener('wheel', blockBodyWheel);
                    document.removeEventListener('keydown', blockBodyKeys);
                }
            }

            // Hover locking is mouse-only: a tap can synthesize mouseenter
            // with no matching mouseleave, which would wedge the lock on.
            const fineHover = window.matchMedia('(hover: hover) and (pointer: fine)');

            function lockBodyScroll() {
                if (!fineHover.matches) return;
                tocHoverLocked = true;
                updateBodyScrollLock();
            }

            function unlockBodyScroll() {
                if (!fineHover.matches) return;
                tocHoverLocked = false;
                updateBodyScrollLock();
            }

            toc.addEventListener('mouseenter', lockBodyScroll);
            toc.addEventListener('mouseleave', unlockBodyScroll);
            
            if (tocToggle) {
                tocToggle.addEventListener('click', openToc);
            }
            
            if (tocBackdrop) {
                tocBackdrop.addEventListener('click', closeToc);
            }
            
            document.addEventListener('keydown', function(e) {
                if (e.key === 'Escape' && toc.classList.contains('mobile-open')) {
                    closeToc();
                }
            });
            
            tocLinks.forEach(link => {
                link.addEventListener('dblclick', function(e) {
                    if (toc.classList.contains('mobile-open')) {
                        closeToc();
                    }
                });
            });
            
            let touchStartY = 0;
            let touchCurrentY = 0;
            let isDragging = false;
            
            tocHandle.addEventListener('touchstart', function(e) {
                if (toc.classList.contains('mobile-open')) {
                    touchStartY = e.touches[0].clientY;
                    isDragging = true;
                }
            });
            
            tocHandle.addEventListener('touchmove', function(e) {
                if (isDragging && toc.classList.contains('mobile-open')) {
                    touchCurrentY = e.touches[0].clientY;
                    const deltaY = touchCurrentY - touchStartY;
                    
                    if (deltaY > 0 && toc.scrollTop === 0) {
                        e.preventDefault();
                        toc.style.transform = `translateY(${deltaY}px)`;
                    }
                }
            });
            
            tocHandle.addEventListener('touchend', function(e) {
                if (isDragging && toc.classList.contains('mobile-open')) {
                    const deltaY = touchCurrentY - touchStartY;
                    
                    if (deltaY > 10) {
                        toc.style.transform = `translateY(150vh)`;
                        closeToc();
                    }
                    
                    isDragging = false;
                }
            });

            function updateTocPosition() {
                const scrollY = window.scrollY;
                if (scrollY > navBottom) {
                    toc.classList.add('scrolled');
                } else {
                    toc.classList.remove('scrolled');
                }
            }

            let tocUpdateDebounce = null;
            
            function updateActiveSection() {
                const scrollPos = window.scrollY;
                
                let activeSection = null;
                for (const section of sections) {
                    if (section.offsetTop <= scrollPos) {
                        activeSection = section;
                    } else {
                        break;
                    }
                }

                tocLinks.forEach(link => link.classList.remove('active'));
                document.querySelectorAll('.toc-subsections').forEach(sub => sub.classList.remove('expanded'));
                
                if (activeSection) {
                    const activeLink = document.querySelector(`.toc-list a[href="#${activeSection.id}"]`);
                    if (activeLink) {
                        activeLink.classList.add('active');
                        
                        let parent = activeLink.parentElement;
                        while (parent && parent !== toc) {
                            if (parent.classList.contains('toc-subsections')) {
                                parent.classList.add('expanded');
                            }
                            parent = parent.parentElement;
                        }
                        
                        const directChildren = activeLink.nextElementSibling;
                        if (directChildren && directChildren.classList.contains('toc-subsections')) {
                            directChildren.classList.add('expanded');
                        }
                        
                        activeLink.scrollIntoView({ block: 'nearest', behavior: 'instant' });
                        
                        const linkRect = activeLink.getBoundingClientRect();
                        const tocRect = toc.getBoundingClientRect();
                        const tocScrollTop = toc.scrollTop;
                        const linkOffsetInToc = activeLink.offsetTop - toc.offsetTop;
                        
                        const maxScroll = toc.scrollHeight - toc.clientHeight;
                        const desiredScroll = Math.min(linkOffsetInToc, maxScroll);
                        
                        if (Math.abs(tocScrollTop - desiredScroll) > 5) {
                            toc.scrollTo({ top: desiredScroll, behavior: 'smooth' });
                        }
                    }
                }
            }

            tocLinks.forEach(link => {
                link.addEventListener('click', function(e) {
                    if (tocUpdateDebounce) {
                        clearTimeout(tocUpdateDebounce);
                    }
                    tocUpdateDebounce = setTimeout(function() {
                        tocUpdateDebounce = null;
                        updateActiveSection();
                    }, 20);
                });
            });

            let scrollTimeout;
            window.addEventListener('scroll', function() {
                if (scrollTimeout) {
                    window.cancelAnimationFrame(scrollTimeout);
                }
                scrollTimeout = window.requestAnimationFrame(function() {
                    updateTocPosition();
                    if (!tocUpdateDebounce) {
                        updateActiveSection();
                    }
                });
            });

            updateTocPosition();
            updateActiveSection();
        });
        {% endif %}

        (function() {
            // Citation hover widget: shows the referenced bibliography entries
            // near the hovered citation. Enhancement only; without JS (or on
            // touch devices) the citation links keep jumping to References.
            var HOVER_QUERY = '(hover: hover) and (pointer: fine)';
            var SHOW_DELAY_MS = 250;
            var HIDE_DELAY_MS = 250;
            var MARGIN_PX = 8;

            var widget = null;
            var showTimer = null;
            var hideTimer = null;
            var currentAnchor = null;

            function ensureWidget() {
                if (!widget) {
                    widget = document.createElement('div');
                    widget.className = 'cite-widget';
                    widget.id = 'cite-widget';
                    widget.setAttribute('role', 'tooltip');
                    widget.hidden = true;
                    document.body.appendChild(widget);
                    widget.addEventListener('mouseleave', scheduleHide);
                }
                return widget;
            }

            function citationKeys(anchor) {
                var span = anchor.closest ? anchor.closest('.citation') : null;
                var raw = span ? span.getAttribute('data-cites') || '' : '';
                var keys = raw.split(/\s+/).filter(function(k) { return k.length > 0; });
                if (keys.length === 0) {
                    var href = anchor.getAttribute('href') || '';
                    var m = href.match(/^#ref-(.+)$/);
                    if (m) { keys = [m[1]]; }
                }
                return keys;
            }

            function buildContent(anchor) {
                var box = ensureWidget();
                box.textContent = '';
                var shown = 0;
                citationKeys(anchor).forEach(function(key) {
                    var entry = document.getElementById('ref-' + key);
                    if (!entry) { return; }
                    var index = entry.querySelector('.csl-left-margin');
                    var body = entry.querySelector('.csl-right-inline');
                    if (!body) { return; }
                    var item = document.createElement('div');
                    item.className = 'cite-widget-entry';
                    var idx = document.createElement('span');
                    idx.className = 'cite-widget-index';
                    idx.textContent = index ? index.textContent : '[' + key + ']';
                    var text = document.createElement('span');
                    text.className = 'cite-widget-text';
                    text.innerHTML = body.innerHTML;
                    item.appendChild(idx);
                    item.appendChild(text);
                    box.appendChild(item);
                    shown += 1;
                });
                return shown > 0;
            }

            function placeWidget(anchor) {
                var box = ensureWidget();
                var rect = anchor.getBoundingClientRect();
                box.hidden = false;
                var w = box.offsetWidth;
                var h = box.offsetHeight;
                var left = rect.left + rect.width / 2 - w / 2;
                left = Math.max(MARGIN_PX, Math.min(left, window.innerWidth - w - MARGIN_PX));
                var top = rect.top - h - MARGIN_PX;
                var below = false;
                if (top < MARGIN_PX) {
                    top = rect.bottom + MARGIN_PX;
                    below = true;
                }
                box.classList.toggle('cite-widget-below', below);
                box.style.left = left + 'px';
                box.style.top = top + 'px';
            }

            function showWidget(anchor) {
                if (!buildContent(anchor)) { return; }
                currentAnchor = anchor;
                anchor.setAttribute('aria-describedby', 'cite-widget');
                placeWidget(anchor);
            }

            function hideWidget() {
                if (showTimer) {
                    clearTimeout(showTimer);
                    showTimer = null;
                }
                if (hideTimer) {
                    clearTimeout(hideTimer);
                    hideTimer = null;
                }
                if (widget && !widget.hidden) {
                    widget.hidden = true;
                }
                if (currentAnchor) {
                    currentAnchor.removeAttribute('aria-describedby');
                    currentAnchor = null;
                }
            }

            function scheduleHide() {
                if (showTimer) {
                    clearTimeout(showTimer);
                    showTimer = null;
                }
                if (hideTimer) {
                    clearTimeout(hideTimer);
                }
                hideTimer = setTimeout(function() {
                    hideTimer = null;
                    hideWidget();
                }, HIDE_DELAY_MS);
            }

            function cancelHide() {
                if (hideTimer) {
                    clearTimeout(hideTimer);
                    hideTimer = null;
                }
            }

            function scheduleShow(anchor) {
                hideWidget();
                showTimer = setTimeout(function() {
                    showTimer = null;
                    showWidget(anchor);
                }, SHOW_DELAY_MS);
            }

            function isCiteLink(node) {
                return !!(node && node.closest &&
                    node.closest('.citation a[role="doc-biblioref"]'));
            }

            document.addEventListener('mouseover', function(e) {
                if (!window.matchMedia(HOVER_QUERY).matches) { return; }
                var anchor = e.target && e.target.closest ?
                    e.target.closest('.citation a[role="doc-biblioref"]') : null;
                if (anchor) {
                    cancelHide();
                    if (anchor !== currentAnchor) {
                        scheduleShow(anchor);
                    }
                } else if (widget && widget.contains(e.target)) {
                    cancelHide();
                } else {
                    scheduleHide();
                }
            });

            document.addEventListener('mouseout', function(e) {
                var anchor = e.target && e.target.closest ?
                    e.target.closest('.citation a[role="doc-biblioref"]') : null;
                if (anchor && widget && widget.contains(e.relatedTarget)) {
                    cancelHide();
                    return;
                }
                if (anchor || (widget && widget.contains(e.target))) {
                    scheduleHide();
                }
            });

            document.addEventListener('focusin', function(e) {
                var anchor = e.target && e.target.closest ?
                    e.target.closest('.citation a[role="doc-biblioref"]') : null;
                if (anchor) {
                    scheduleShow(anchor);
                }
            });

            document.addEventListener('focusout', function(e) {
                if (widget && widget.contains(e.relatedTarget)) {
                    return;
                }
                var anchor = e.target && e.target.closest ?
                    e.target.closest('.citation a[role="doc-biblioref"]') : null;
                if (anchor) {
                    hideWidget();
                }
            });

            document.addEventListener('keydown', function(e) {
                if (e.key === 'Escape') {
                    hideWidget();
                }
            });

            document.addEventListener('click', function(e) {
                if (isCiteLink(e.target)) {
                    hideWidget();
                }
            });

            window.addEventListener('scroll', hideWidget, { capture: true, passive: true });
            window.addEventListener('resize', hideWidget);
        })();
    </script>
</body>
</html>
